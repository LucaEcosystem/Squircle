# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test output
test-results/
playwright-report/
coverage/

# Screenshots produced by ad-hoc local checks (committed review
# captures live under docs/reviews/)
.screenshots/

# Generated trim outputs (regenerated by tests; never committed)
fixtures/**/squircle.trimmed.css
fixtures/**/trim-report.json

# Package tarballs (npm pack output)
*.tgz

# Local scratch / ad-hoc working files
.work-tmp/
tests/playwright.config.reuse.ts

# The consumer fixture tarball is a *committed test artifact* (lets
# `npm install` resolve the public package without a build step or
# network). Regenerate it with: `pnpm -C packages/squircle build &&
# pnpm -C packages/squircle exec npm pack --pack-destination
# ../../fixtures/consumers/_tarball`. Do NOT ignore it.
!fixtures/consumers/_tarball/*.tgz

# OS / editor
.DS_Store
.vscode/
.idea/

# Env
.env
.env.local

# Generated docs-site output (static site, prettier-formatted)
!docs-site/dist/

