{
  "name": "@luca-ecosystem/squircle",
  "version": "1.1.0",
  "license": "MIT",
  "description": "Squircle — a CSS-first UI framework with squircle geometry, generous whitespace, and the Luca Ecosystem Theme. No build step required; no TypeScript required.",
  "keywords": [
    "css",
    "framework",
    "design-system",
    "components",
    "utilities",
    "accessible",
    "squircle"
  ],
  "homepage": "https://github.com/LucaEcosystem/Squircle",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucaEcosystem/Squircle.git",
    "directory": "Framework/packages/squircle"
  },
  "type": "module",
  "main": "./dist/squircle-runtime.mjs",
  "module": "./dist/squircle-runtime.mjs",
  "types": "./dist/index.d.ts",
  "style": "./dist/squircle.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/squircle-runtime.mjs",
      "default": "./dist/squircle-runtime.mjs"
    },
    "./css": "./dist/squircle.css",
    "./css/min": "./dist/squircle.min.css",
    "./css/tokens": "./dist/tokens.css",
    "./css/fonts": "./dist/fonts.css",
    "./browser": "./dist/squircle-runtime.js",
    "./icons/sprite": "./dist/squircle-icons.svg",
    "./icons/manifest": "./dist/icons.json",
    "./icons/*": "./dist/icons/*.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ./build.mjs",
    "check": "node ./check.mjs",
    "clean": "rm -rf dist",
    "prepack": "node ./build.mjs"
  }
}
